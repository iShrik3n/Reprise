{
  "name": "reprise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turn a song into a time × time artwork: a colored self-similarity matrix, computed entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
